# Copy to .env and fill in. NEVER commit the real .env.
#
# These are the ONLY values the sync needs to resume on any host
# (Render worker / Railway / a fresh sandbox):
#   this .env  +  data/archive.db (the LFS snapshot)  +  the code

# --- Telegram API credentials (my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Your logged-in session (from `python main.py auth`) ---
# This is what authenticates the copy. Treat it like a password.
TELEGRAM_STRING_SESSION=

# --- Chat IDs (negative numbers) ---
SOURCE_CHAT_ID=          # the channel the files come from
ARCHIVE_1_CHAT_ID=       # Dump 1
ARCHIVE_2_CHAT_ID=       # Dump 2
ARCHIVE_3_CHAT_ID=       # Dump 3

# --- Storage ---
DB_PATH=./data/archive.db

# --- Optional pacing override (seconds between account-wide Telegram ops) ---
# SYNC_GLOBAL_GAP=1.5
